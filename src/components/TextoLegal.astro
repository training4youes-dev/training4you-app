---
interface Props {
	titulo: string;
	actualizacion: string;
}

const { titulo, actualizacion } = Astro.props;
---

<article class="texto-legal">
	<h1 class="pagina">{titulo}</h1>
	<p class="texto-legal-fecha">Última actualización: {actualizacion}</p>
	<slot />
	<nav class="texto-legal-nav" aria-label="Documentos legales">
		<a href="/aviso-legal">Aviso legal</a>
		<a href="/privacidad">Política de privacidad</a>
		<a href="/cookies">Política de cookies</a>
	</nav>
</article>
