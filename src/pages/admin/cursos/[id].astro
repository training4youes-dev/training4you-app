---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminCursoForm from '../../../components/AdminCursoForm.astro';
import { NOMBRE_COOKIE_ADMIN, sesionValida } from '../../../lib/auth';
import {
	actualizarCurso,
	borrarCurso,
	cursoDesdeFormulario,
	cursoPorId,
} from '../../../lib/cursos';
import { borrarFotoStorage, esUrlStorageCursos, resolverFotoCurso } from '../../../lib/storage';

if (!sesionValida(Astro.cookies.get(NOMBRE_COOKIE_ADMIN)?.value)) {
	return Astro.redirect('/admin');
}

const id = Number(Astro.params.id);
if (!Number.isFinite(id) || id <= 0) {
	return Astro.redirect('/admin/cursos');
}

let error = '';
let aviso = '';

const cursoAntes = await cursoPorId(id);
if (!cursoAntes) {
	return Astro.redirect('/admin/cursos');
}

if (Astro.request.method === 'POST') {
	const datos = await Astro.request.formData();
	const accion = String(datos.get('accion') ?? '');

	if (accion === 'borrar') {
		if (esUrlStorageCursos(cursoAntes.foto)) {
			await borrarFotoStorage(cursoAntes.foto);
		}
		await borrarCurso(id);
		return Astro.redirect('/admin/cursos');
	}

	if (accion === 'guardar') {
		try {
			const curso = cursoDesdeFormulario(datos);
			if (!curso.nombre || !curso.aprender) {
				throw new Error('Nombre y “qué se aprende” son obligatorios');
			}
			curso.foto = await resolverFotoCurso(datos, curso.slug, cursoAntes.foto);
			const actualizado = await actualizarCurso(id, curso);
			if (!actualizado) {
				return Astro.redirect('/admin/cursos');
			}
			aviso = 'Curso guardado.';
		} catch (e) {
			error = e instanceof Error ? e.message : 'No se pudo guardar el curso';
			if (String(error).includes('duplicate') || String(error).includes('unique')) {
				error = 'Ya existe un curso con ese slug. Cambia el slug o el nombre.';
			}
		}
	}
}

const curso = (await cursoPorId(id)) ?? cursoAntes;
---

<AdminLayout title={`${curso.nombre} · Admin`} activa="cursos">
	<section class="admin-panel">
		<header class="admin-cabecera">
			<div>
				<p class="admin-migas">
					<a href="/admin/cursos">Cursos</a>
					<span>/</span>
					<span>Editar</span>
				</p>
				<h1 class="pagina">{curso.nombre}</h1>
				<p class="admin-resumen">
					{curso.publicado ? 'Publicado' : 'Oculto'} · /cursos/{curso.slug}
				</p>
			</div>
			<div class="admin-cabecera-acciones">
				{
					curso.publicado ? (
						<a class="btn btn-linea" href={`/cursos/${curso.slug}`} target="_blank" rel="noreferrer">
							Ver en la web
						</a>
					) : null
				}
			</div>
		</header>

		{aviso ? <p class="admin-ok">{aviso}</p> : null}
		<AdminCursoForm curso={curso} error={error} />

		<aside class="admin-zona-peligro">
			<p class="admin-zona-peligro-texto">
				Borrar esta ficha la quita de la web y del admin. No se puede deshacer.
			</p>
			<form method="POST">
				<input type="hidden" name="accion" value="borrar" />
				<button
					type="submit"
					class="btn admin-btn-borrar"
					onclick="return confirm('¿Eliminar este área / curso completo?')"
				>
					Eliminar curso
				</button>
			</form>
		</aside>
	</section>
</AdminLayout>
